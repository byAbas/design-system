{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/byAbas/design-system/plugins/design-system/assets/report.schema.json",
  "title": "design-system audit report",
  "description": "The report /design-system:audit writes. references/report.md explains each field.",
  "type": "object",
  "required": ["schemaVersion", "tool", "project", "date", "stack", "parts", "findings", "gates", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["design-system", "design-tokens"], "description": "design-tokens in reports written before 0.6.0" },
        "version": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "root"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string" },
        "commit": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" }
      }
    },
    "date": { "type": "string", "format": "date" },
    "baseline": { "type": "string", "description": "The report this project compares against, from design-system/gates.json audits.baseline (references/report.md, Retention)" },
    "stack": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "enum": ["terrazzo-tailwind-v4", null] },
        "targetProfile": { "enum": ["terrazzo-tailwind-v4"], "description": "The profile whose assets the recommended gates use, when profile is null" },
        "tokenFormat": { "type": ["string", "null"] },
        "styling": { "type": "array", "items": { "type": "string" } },
        "rulesDocument": { "type": ["string", "null"] },
        "tokenSettings": { "type": "object" },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["installed"],
            "properties": {
              "installed": { "type": ["string", "null"] },
              "latest": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "status", "summary"],
        "properties": {
          "id": { "enum": ["naming", "tiers", "format", "docs"] },
          "status": { "enum": ["met", "partial", "missing"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ruleId", "part", "severity", "title", "location", "why", "fix"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+@[^\\s]*#[^\\s]*$" },
          "ruleId": { "type": "string", "pattern": "^(naming|tiers|format|docs)/[a-z0-9-]+$" },
          "part": { "enum": ["naming", "tiers", "format", "docs"] },
          "severity": { "enum": ["error", "warning", "info"] },
          "title": { "type": "string", "minLength": 1 },
          "location": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string" },
              "pointer": { "type": "string" }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file"],
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "excerpt": { "type": "string" }
              }
            }
          },
          "previousIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+@[^\\s]*#[^\\s]*$" } },
          "requires": { "type": "array", "description": "Findings of this report that must be closed before this one: its fix breaks the project while they are open (references/report.md, Fix order)", "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+@[^\\s]*#[^\\s]*$" } },
          "status": { "enum": ["open", "accepted", "out-of-scope"], "description": "open (the default); accepted, a known problem suppressed in design-system/suppressions.json; out-of-scope, in a path design-system/gates.json exempts (references/report.md, Status)" },
          "statusReason": { "type": "string", "minLength": 1, "description": "Why it is accepted or out of scope: the suppression's or the exemption's reason" },
          "why": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "does", "checks", "tool", "runs", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^gate/[a-z0-9-]+$" },
          "does": { "type": "string", "minLength": 1 },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "closes": { "type": "array", "items": { "type": "string" } },
          "tool": {
            "type": "object",
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "enum": ["existing", "custom"] },
              "basis": { "type": "string" }
            }
          },
          "runs": { "type": "array", "minItems": 1, "items": { "enum": ["agent-edit", "agent-commit", "commit", "ci"] } },
          "status": { "enum": ["present", "partial", "missing"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    }
  }
}
